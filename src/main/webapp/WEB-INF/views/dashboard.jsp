<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.codequest.model.Player" %><%@ include file="partials/header.jspf" %>
<% Player player=(Player)request.getAttribute("player"); %>
<main class="container"><div class="pagehead"><span class="eyebrow">PLAYER COMMAND CENTER</span><h1>Welcome back, <%=player==null?"Player":WebUtil.escape(player.username)%>!</h1><p>Every challenge brings you closer to the next level.</p></div><%@ include file="partials/message.jspf" %>
<% if(player!=null){ %><div class="stats"><div class="stat"><span>Total Experience</span><strong><%=player.xp%> XP</strong><small>Keep earning</small></div><div class="stat"><span>Current Level</span><strong><%=player.level%></strong><small>Next level at <%=player.level*100%> XP</small></div><div class="stat"><span>Correct Missions</span><strong><%=player.completed%></strong><small>Successfully solved</small></div></div>
<div class="panel" style="margin-top:23px"><div class="space"><h2>Level <%=player.level%> Progress</h2><span class="pill green"><%=player.xp%100%>/100 XP</span></div><div class="progress"><div class="bar" style="width:<%=player.xp%100%>%"></div></div><p class="muted">Earn <%=100-(player.xp%100)%> more XP to reach Level <%=player.level+1%>.</p></div><% } %>
<div class="two-col"><div class="card"><div class="symbol">⌨</div><h3>Continue Your Quest</h3><p>Browse Java, SQL and DSA challenges to grow your XP.</p><a class="btn" href="<%=ctx%>/missions">View Missions &rarr;</a></div><div class="card"><div class="symbol">🏆</div><h3>See Your Ranking</h3><p>Find your position alongside the top CodeQuest players.</p><a class="btn ghost" href="<%=ctx%>/leaderboard">View Leaderboard</a></div></div></main><%@ include file="partials/footer.jspf" %>
