<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,com.codequest.model.Mission" %><%@ include file="partials/header.jspf" %>
<main class="container"><div class="pagehead"><span class="eyebrow">CHALLENGE ARENA</span><h1>Programming Missions</h1><p>Choose a topic, select your answer and earn XP when you're correct. One attempt per mission.</p></div><%@ include file="partials/message.jspf" %>
<form method="get" action="<%=ctx%>/missions" class="filters"><div><label>Category</label><select name="category"><option value="">All categories</option><% for(String item:new String[]{"Java","SQL","DSA"}){ %><option <%=item.equals(request.getAttribute("category"))?"selected":""%>><%=item%></option><% } %></select></div><div><label>Difficulty</label><select name="difficulty"><option value="">All difficulties</option><% for(String item:new String[]{"Easy","Medium","Hard"}){ %><option <%=item.equals(request.getAttribute("difficulty"))?"selected":""%>><%=item%></option><% } %></select></div><button class="btn" type="submit">Filter Missions</button></form>
<% List<Mission> missions=(List<Mission>)request.getAttribute("missions"); if(missions==null||missions.isEmpty()){ %><div class="panel empty">No missions match these filters. Ask your administrator to add some challenges.</div><% }else{for(Mission m:missions){ %>
<div class="mission-card"><div class="space"><div><span class="pill"><%=WebUtil.escape(m.category)%></span> <span class="pill gold"><%=WebUtil.escape(m.difficulty)%></span></div><span class="pill green">+<%=m.xp%> XP</span></div><h2><%=WebUtil.escape(m.title)%></h2><p class="muted"><%=WebUtil.escape(m.description)%></p>
<% if(m.attempted){ %><div class="message success">Already attempted · This mission is locked.</div><% }else{ %>
<form method="post" action="<%=ctx%>/submit-answer"><input type="hidden" name="csrf" value="<%=WebUtil.escape(WebUtil.token(request))%>"><input type="hidden" name="missionId" value="<%=m.id%>"><div class="options">
<label class="option"><input type="radio" name="answer" value="A" required> A. <%=WebUtil.escape(m.a)%></label><label class="option"><input type="radio" name="answer" value="B"> B. <%=WebUtil.escape(m.b)%></label><label class="option"><input type="radio" name="answer" value="C"> C. <%=WebUtil.escape(m.c)%></label><label class="option"><input type="radio" name="answer" value="D"> D. <%=WebUtil.escape(m.d)%></label>
</div><button class="btn" type="submit">Submit Answer &rarr;</button></form><% } %></div>
<% }} %></main><%@ include file="partials/footer.jspf" %>
